# ============================================================
# CASSANDRA — CONFIGURAÇÃO
# ============================================================
# Copie para .env e preencha. NUNCA versione o .env.
#
# A Cassandra aceita QUALQUER provedor compatível com a API OpenAI
# (/chat/completions). Basta colar a chave — o provedor é detectado
# automaticamente pelo formato da chave.
# ============================================================

# --- Opção 1: chave genérica (auto-detecção pelo formato) ---
# Funciona com nvapi-*, sk-ant-*, sk-or-*, gsk_*, xai-*, pplx-*, fw_*,
# csk-*, AIza*, sk-proj-*, sk-<32hex>
CASSANDRA_API_KEY=""

# --- Opção 2: várias chaves (rotação automática entre provedores) ---
# Separadas por vírgula. A Cassandra rotaciona quando uma queima.
CASSANDRA_API_KEYS=""

# --- Opção 3: variáveis por provedor (todas opcionais) ---
# NVIDIA_API_KEY="nvapi-..."
# DEEPSEEK_API_KEY="sk-..."
# OPENAI_API_KEY="sk-proj-..."
# ANTHROPIC_API_KEY="sk-ant-..."
# OPENROUTER_API_KEY="sk-or-..."
# GROQ_API_KEY="gsk_..."
# XAI_API_KEY="xai-..."
# MISTRAL_API_KEY="..."
# GEMINI_API_KEY="AIza..."
# PERPLEXITY_API_KEY="pplx-..."
# TOGETHER_API_KEY="..."
# FIREWORKS_API_KEY="fw_..."
# CEREBRAS_API_KEY="csk-..."
# DEEPINFRA_API_KEY="..."
# HYPERBOLIC_API_KEY="..."
# SAMBANOVA_API_KEY="..."

# --- Overrides manuais (opcionais) ---
# Força um provedor específico em vez da auto-detecção.
CASSANDRA_PROVIDER=""
# Endpoint custom (OpenAI-compatible próprio).
CASSANDRA_BASE_URL=""
# Modelo específico.
CASSANDRA_MODEL=""

# ============================================================
# FILTRO ANTI-BANIMENTO
# ============================================================
# Espaçamento mínimo entre requisições (segundos).
CASSANDRA_MIN_INTERVAL="2.5"
# Jitter aleatório adicional (segundos) — evita padrão de tempo.
CASSANDRA_JITTER="1.5"
# Tentativas por requisição antes de desistir.
CASSANDRA_MAX_ATTEMPTS="4"
# Base do recuo exponencial (segundos).
CASSANDRA_BACKOFF_BASE="1.5"
# Teto do recuo (segundos).
CASSANDRA_BACKOFF_CAP="60"
# Cooldown do circuit breaker após sinal de abuso (segundos).
CASSANDRA_COOLDOWN="120"
# Cooldown de uma chave queimada antes de tentar de novo (segundos).
CASSANDRA_KEY_COOLDOWN="300"

# ============================================================
# EVASÃO DE FILTRO
# ============================================================
# Sanitiza termos-gatilho antes do envio (1=on, 0=off).
CASSANDRA_SANITIZE="1"
# Cifra o payload em envelope com instrução de decodificação (1=on, 0=off).
CASSANDRA_ENCRYPT="1"
# Semente do envelope cifrado. Fixe para que envelopes sejam
# reproduzíveis entre execuções.
CASSANDRA_CIPHER_SEED="cassandra-envelope-v1"

# ============================================================
# GUARDA ANTI-RECUSA
# ============================================================
# Ativa a reescrita automática quando o modelo recusa (1=on, 0=off).
# Quando ligada, um pedido com termos que disparam recusa é reescrito
# em vocabulário técnico neutro ANTES do envio, e reescrito de novo
# (com mais reforço) se o modelo recusar mesmo assim.
CASSANDRA_GUARD="1"
# Quantas vezes reenviar após uma recusa (0-5). Cada tentativa usa uma
# estratégia diferente: normal -> agressiva -> agressiva + override.
CASSANDRA_REFUSAL_RETRIES="2"

# ============================================================
# INTERFACE
# ============================================================
# Porta da interface web (--web).
CASSANDRA_WEB_PORT="8080"
# Timeout de leitura do stream (segundos).
CASSANDRA_API_STREAM_TIMEOUT="300"

# ============================================================
# TIMEOUTS — COMANDOS E STREAM
# ============================================================
# Timeout máximo de comandos shell (segundos). Default: 1800 (30 min).
# Defina como "0" para desabilitar (comando roda até terminar).
CASSANDRA_SHELL_TIMEOUT="1800"
# Silêncio máximo entre chunks do stream (segundos). Default: 120.
# Se o modelo demorar mais que isso entre chunks, o stream é abortado.
CASSANDRA_STREAM_IDLE_TIMEOUT="120"
# Tempo máximo total de um stream (segundos). Default: 3600 (1h).
# Defina como "0" para desabilitar o limite total.
CASSANDRA_STREAM_TOTAL_TIMEOUT="3600"

# Diretório de skills.
CASSANDRA_SKILLOGY="./cassandra-skill"
# Diretório de logs.
CASSANDRA_LOG_DIR="./logs"
